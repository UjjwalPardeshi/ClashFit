<?xml version="1.0" encoding="utf-8"?>
<!--
  No <monochrome> layer on purpose. With themed icons switched on, Android tints
  a monochrome layer flat; this mark is an ember field with the bolt knocked out
  of it, so tinting it produced a solid blob with no bolt at all. Omitting the
  layer makes the launcher fall back to the real colour icon instead.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
